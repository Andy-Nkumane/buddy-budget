{
  "name": "buddy-budget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:pwa": "npm run build && vite preview --host 0.0.0.0 --port 5173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:compliance": "node --test scripts/check-compliance-boundaries.test.mjs && node scripts/check-compliance-boundaries.mjs",
    "test:workflows": "node --test scripts/check-workflow-security.test.mjs && node scripts/check-workflow-security.mjs",
    "test:dependencies": "node --test scripts/check-dependency-policy.test.mjs && node scripts/check-dependency-policy.mjs",
    "check:artifacts": "node scripts/check-public-artifact-boundaries.mjs",
    "test:secrets": "node scripts/test-secret-scanning.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:compliance": "playwright test e2e/legal-navigation.spec.ts e2e/privacy-policy.spec.ts e2e/registration-transparency.spec.ts",
    "test:db": "supabase test db",
    "audit": "npm audit --audit-level=low",
    "assets:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "deepmerge": "4.1.1",
    "ejs": "7.0.2",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "allowScripts": {
    "core-js@3.51.0": true
  }
}
